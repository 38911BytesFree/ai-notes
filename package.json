{
  "name": "ai-notes",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev-emulator.mjs",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "cd api && go run ./cmd/api",
    "build": "pnpm --filter web build",
