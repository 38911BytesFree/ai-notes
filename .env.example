# Project id for Firebase Admin and Firestore (must match emulator project id locally)
GOOGLE_CLOUD_PROJECT=

# Bind address for the Go API server (default: 0.0.0.0:8000)
BIND_ADDRESS=

# Host and port for Firestore emulator (local dev only, set by dev script)
FIRESTORE_EMULATOR_HOST=

# Host and port for Firebase Auth emulator (local dev only, set by dev script)
FIREBASE_AUTH_EMULATOR_HOST=

# URL of the Go backend API service (local: http://127.0.0.1:8000)
BACKEND_URL=

# Force backend ID-token minting on or off ("true" / "false", auto-detected if unset)
BACKEND_USE_ID_TOKEN=

# Cookie signing secret for session cookies (Secret Manager in prod)
SESSION_SECRET=

# Node environment mode ("production" on Cloud Run)
NODE_ENV=

# Public Firebase web API key baked into the client bundle at build time
VITE_FIREBASE_API_KEY=

# Public Firebase auth domain baked into the client bundle at build time
VITE_FIREBASE_AUTH_DOMAIN=

# Public Firebase project ID baked into the client bundle at build time
VITE_FIREBASE_PROJECT_ID=

# Public Firebase storage bucket baked into the client bundle at build time
VITE_FIREBASE_STORAGE_BUCKET=

# Public Firebase messaging sender ID baked into the client bundle at build time
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Public Firebase web app ID baked into the client bundle at build time
VITE_FIREBASE_APP_ID=

# Public Firebase measurement ID baked into the client bundle at build time
VITE_FIREBASE_MEASUREMENT_ID=

# Points the browser Firebase SDK at the Auth emulator (local dev only)
VITE_FIREBASE_AUTH_EMULATOR_HOST=
