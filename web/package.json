{
  "name": "web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "react-router build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=build/server/index.js",
    "start": "node build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"

  },
  "dependencies": {
    "@react-router/express": "^7.15.1",
    "@react-router/node": "^7.15.1",
    "compression": "^1.8.0",
    "express": "^4.21.2",
    "firebase": "^12.13.0",
    "google-auth-library": "^10.7.0",
    "isbot": "^5.1.40",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.15.1"
  },
  "devDependencies": {
    "@react-router/dev": "^7.15.1",
    "@react-router/fs-routes": "^7.15.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
}
